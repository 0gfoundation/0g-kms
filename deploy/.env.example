# Copy to .env and fill in. Operational values interpolated into the compose; the compose file
# itself stays environment-agnostic, so moving the monitoring host is an .env edit, not a
# compose edit. Do not commit the filled-in .env.

# Central Loki push endpoint for the alloy log shipper. Point it at the monitoring host.
# The node must be able to reach this host:port — open it in the host firewall / cloud SG.
LOKI_URL=http://CENTRAL_LOKI_HOST:3100/loki/api/v1/push
