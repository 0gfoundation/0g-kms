# Copy to .env on each host and adjust for that node.
KMS_CONFIG=./kms.toml       # node config for THIS host: kms.toml | kms-node2.toml | kms-node3.toml
KMS_HTTP_PORT=9090          # host port → container 9090 (/app-key, /refresh)
KMS_GRPC_PORT=9092          # host port → container 9092 (inter-node gRPC)
# KMS_IMAGE=eliza-registry-vpc.ap-southeast-1.cr.aliyuncs.com/eliza/0g-kms:latest
